+    // Tekken 4 port: hash of the pages an indexed texture's texels read (0 = never revalidated). spanBlocks() is a
+    // solid rectangle the whole buffer width wide, so a neighbour upload (the Arena fight's 16x16 CT32 writes) changed
+    // the hash and the texture was fully re-decoded every frame: half the GS thread (GSMem::ReadIndexRun), 37 fps.
+    uint64_t hashIndexedCoverage(uint32_t tbp, uint32_t psm, uint32_t tbw, uint32_t width, uint32_t height) const
+    {
+        uint32_t pageW = 64u, pageH = 32u; // T8H/T4HL/T4HH use the CT32 page
+        switch (psm & 63u)
+        {
+        case GS_PSM_T8: pageW = 128u; pageH = 64u; break;
+        case GS_PSM_T4: pageW = 128u; pageH = 128u; break;
+        case GS_PSM_T8H:
+        case GS_PSM_T4HL:
+        case GS_PSM_T4HH: break;
+        default: pageH = pageRowsFor(psm); break;
+        }
+        const uint32_t pagesAcross = std::max<uint32_t>(1u, (std::max<uint32_t>(1u, tbw) * 64u) / pageW);
+        const uint32_t usedAcross = std::min(pagesAcross, (std::max<uint32_t>(1u, width) + pageW - 1u) / pageW);
+        const uint32_t pagesDown = (std::max<uint32_t>(1u, height) + pageH - 1u) / pageH;
+        uint64_t hash = 1469598103934665603ull;
+        for (uint32_t py = 0; py < pagesDown; ++py)
+        {
+            for (uint32_t px = 0; px < usedAcross; ++px)
+            {
+                // GS addresses are base + page * 32 + block in page, so this holds for a base inside a page too.
+                const uint32_t block = tbp + (py * pagesAcross + px) * 32u;
+                const uint64_t pageHash = hashBlocks(block, block + 32u);
+                if (pageHash == 0u)
+                    return 0u;
+                hash = (hash ^ pageHash) * 1099511628211ull;
+            }
+        }
+        return hash | 1u;
+    }
+
     // Raw GS memory of blocks [lo, hi) (256 bytes each); 0 when the range wraps past the end (never revalidated).
     uint64_t hashBlocks(uint32_t lo, uint32_t hi) const
     {
